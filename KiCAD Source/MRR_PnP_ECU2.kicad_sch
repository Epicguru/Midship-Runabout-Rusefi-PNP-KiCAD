	)
	(text "Inside each block parts are wired; nets that leave a block use net labels (same name = same net). J1, U1, the landing headers and the ESP32 pins are labelled."
		(exclude_from_sim no)
		(at 17.78 341.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
