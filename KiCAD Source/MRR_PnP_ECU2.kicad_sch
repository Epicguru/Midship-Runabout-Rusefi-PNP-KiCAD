		(uuid "a747a513-0b23-41c4-bea9-3a6903fb8692")
	)
	(text "  - U10 tab: no copper connection on the board (only pin 2 is grounded).  - U7/U8 NC pins 1, 4, 6, 13 are tied to GND as on the board; check the LM1815 datasheet."
		(exclude_from_sim no)
		(at 17.78 356.87 0)
		(effects
